PORT=3000
DATABASE_URL=postgresql://phonemail:phonemail_dev_password@localhost:5432/phonemail
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_DOMAIN=demo.phonemail.test

# Hackathon mode: OTP is shown in the app and no SMS is sent.
# For real SMS, set OTP_MODE=twilio and provide all Twilio values below.
OTP_MODE=demo
OTP_SECRET=replace-with-another-long-random-secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional real outbound email through a verified Brevo sender.
# External messages are rejected unless these are configured.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO_EMAIL=

# SMTP is optional; local Docker Compose defaults to Mailpit. Render Free blocks SMTP ports.
